{
  "compilerOptions": {
    "composite": true,
    // Project is built by electron-vite; tsc is type-check-only. But
    // `composite: true` forces emit — `tsc --noEmit` is rejected in
    // composite mode. Redirect emit to a gitignored scratch dir so
    // `tsc -b` doesn't pollute src/ with ~200 `.js` / `.d.ts` files
    // sitting next to every source. See .gitignore for the full story.
    "outDir": "./.tsc-out/web",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "types": ["node"],
    // See tsconfig.node.json for the full rationale. Both projects
    // declare the same alias map so imports resolve identically
    // whether tsc is checking the main/preload or the renderer half.
    "baseUrl": ".",
    "paths": {
      "claude-code-headless": ["./packages/claude-code-headless/src/index.ts"],
      "claude-code-headless/*": ["./packages/claude-code-headless/src/*"],
      "codex-headless": ["./packages/codex-headless/src/index.ts"],
      "codex-headless/*": ["./packages/codex-headless/src/*"],
      "opencode-headless": ["./packages/opencode-headless/src/index.ts"],
      "opencode-headless/*": ["./packages/opencode-headless/src/*"],
      "agent-transcript-parser": ["./packages/agent-transcript-parser/src/index.ts"],
      "agent-transcript-parser/*": ["./packages/agent-transcript-parser/src/*"],
      "workflow-mcp/state": ["./packages/workflow-mcp/src/state.ts"],
      "@main/*": ["./src/main/*"],
      "@preload/*": ["./src/preload/*"],
      "@renderer/*": ["./src/renderer/src/*"],
      "@shared/*": ["./src/shared/*"],
      "@providers/*": ["./src/providers/*"],
      "@mcp/*": ["./src/mcp/*"]
    }
  },
  "include": [
    "src/renderer/**/*",
    // Renderer specs use the DOM matchers installed by the Vitest setup module. The setup lived
    // outside every web include glob, so runtime tests passed while the authoritative web checker
    // could not see its `expect` augmentation. Include the one shared setup instead of adding
    // matcher imports to individual specs and letting the two test environments drift.
    "testing/setup/renderer.ts",
    // This fixture exporter imports the canonical renderer redactor and the
    // production Dispatch selectors on purpose: the recorded corpus must be
    // minimized and replay-verified by the same ownership boundaries the app
    // uses. Keep it in the web project so callback selection, fixture-state
    // assumptions, and selector API drift fail the normal typecheck instead of
    // surfacing only when someone refreshes the evidence months later.
    "scripts/extract-work-context-fixtures.mts",
    // Curated rendering-shape fixtures are imported by provider adapter and
    // DOM contracts. Composite TypeScript refuses transitive JSON that is not
    // named in the project file list; keeping the fixture tree explicit makes
    // the authoritative typecheck validate those evidence contracts instead
    // of forcing tests to duplicate captured structures inline.
    "testing/fixtures/rendering-shapes/**/*.json",
    // The phone client is browser code type-checked here (react-jsx, DOM
    // lib) even though it builds through its own plain-Vite config — the
    // tsc gate must cover it or client drift ships silently.
    "src/remote-client/**/*",
    // sessionFeed is the shared contract between renderer, remote client,
    // and (via re-exports) preload; listed explicitly like the other shared
    // subtrees so it is always in a checked file list.
    "src/shared/sessionFeed/**/*",
    "src/preload/index.d.ts",
    "src/shared/code/**/*",
    "src/shared/types/**/*",
    "src/shared/performance/**/*",
    "src/shared/parsers/**/*",
    "src/shared/renderedContent/**/*",
    "src/shared/work-context/**/*",
    "src/mcp/shared/**/*",
    // conditions-core is split across both projects: contract.ts/view.ts/
    // dispatch.ts are node-safe (checked by tsconfig.node.json), and
    // ConditionOutlet.tsx is renderer-only JSX (the node project EXCLUDES it
    // and the web project checks it under jsx: react-jsx). Today ConditionOutlet
    // is only reached TRANSITIVELY (via ProviderConditionOutlet's import graph),
    // so if nothing imported it, it would silently fall out of every project's
    // file list and go un-type-checked. Including the whole tree explicitly here
    // makes the web project the authoritative checker for the renderer-only file
    // regardless of who imports it. (The .tsx stays excluded from the node
    // project — see tsconfig.node.json — so node never sees JSX.)
    "src/shared/conditions-core/**/*",
    "src/providers/*/parsers/**/*",
    "src/providers/*/renderer/**/*",
    // The spawn-tool test lives at providers/ ROOT beside the capability
    // registry it tests (moved from features/feed in #493 PR-2). The two
    // globs above don't reach providers-root files, and nothing imports a
    // test — without this line it would fall out of every project's file
    // list and go un-type-checked (the registry itself rides in
    // transitively via renderer imports; the node project excludes both).
    "src/providers/registry.renderer.capabilities.spawnTool.test.ts",
    // Shape-catalog registry + Phase 4 coverage gate (PR #555): providers-
    // root files importing the per-provider shapes.ts catalogs and renderer
    // evidence modules — web-project citizens for the same reason as the
    // capability registry (node project excludes them; see
    // tsconfig.node.json's matching exclude comment).
    "src/providers/registry.renderShapes.ts",
    "src/providers/shapes.coverage.test.ts",
    // registry.renderer.ts lives at providers/ root, outside the
    // `*/renderer/**/*` glob above. TileTree imports it to mount
    // provider-specific TileLeaf components, so the web project
    // needs the file explicitly. (The node project *excludes* this
    // file — see tsconfig.node.json — because it transitively pulls
    // the entire renderer subtree in.)
    "src/providers/registry.renderer.ts",
    // Capability-only provider registry is imported by feed rows and
    // ProviderConditionOutlet, but it intentionally sits beside
    // registry.renderer.ts instead of under `*/renderer/**/*` to avoid a TileLeaf
    // import cycle. Keep it explicit so composite tsc checks the file even when
    // no provider pane imports it directly.
    "src/providers/registry.renderer.capabilities.ts"
  ],
  // Project reference: tell tsc to resolve preload imports via node's
  // emitted declarations, not by walking the source tree. Without
  // this, `src/preload/index.d.ts` traces `./index` → `index.ts` →
  // `./api/*.ts` and the web project errors TS6307 because the
  // api/*.ts files aren't in this project's include list. The
  // reference makes `tsc -b` build tsconfig.node.json first, drop
  // its declarations in `.tsc-out/node/`, and have this web project
  // consume those instead of chasing source files out of scope.
  "references": [
    { "path": "./tsconfig.node.json" }
  ]
}
