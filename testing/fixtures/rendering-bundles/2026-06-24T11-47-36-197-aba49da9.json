start gap-4 lg:grid-cols-3\">\n+        <div className=\"grid gap-4 lg:col-span-2\">\n+          <Card>\n+            <CardHeader>\n+              <CardTitle>Status</CardTitle>\n+            </CardHeader>\n+            <CardContent>\n+              <div className=\"flex gap-3 rounded-lg border bg-muted/30 p-4\">\n+                {isPassing ? (\n+                  <CheckCircle2 className=\"mt-0.5 size-5 shrink-0 text-[var(--success)]\" />\n+                ) : (\n+                  <TriangleAlert className=\"mt-0.5 size-5 shrink-0 text-[#b5740d]\" />\n+                )}\n+                <div>\n+                  <div className=\"text-sm font-semibold\">\n+                    {isPassing ? \"Kontrollen följs\" : \"Kontrollen kräver åtgärd\"}\n+                  </div>\n+                  <p className=\"mt-1 text-[13.5px] leading-relaxed text-muted-foreground\">\n+                    {item.detail}\n+                  </p>\n+                </div>\n+              </div>\n+            </CardContent>\n+          </Card>\n+\n+          <Card>\n+            <CardHeader>\n+              <CardTitle>Kontrolldata</CardTitle>\n+            </CardHeader>\n+            <CardContent className=\"py-2\">\n+              {[\n+                [\"Kontroll-ID\", item.id],\n+                [\"Gäller\", item.propertyName],\n+                [\"Status\", item.status],\n+                [\"Senaste granskning\", \"Automatisk mock-kontroll\"],\n+              ].map(([label, value]) => (\n+                <div\n+                  key={label}\n+                  className=\"flex items-center justify-between gap-3 border-b py-3 last:border-0\"\n+                >\n+                  <span className=\"text-sm text-muted-foreground\">{label"}},"blockOrder":[0,1,2],"stopReason":null,"usage":null,"task":{"todos":[],"doneCount":0,"totalCount":0,"inProgressToolUseIds":[],"activeToolNames":[]},"lookups":{"toolCallsById":{},"toolUseIdsInOrder":[],"resolvedToolUseIds":[],"erroredToolUseIds":[]},"starte